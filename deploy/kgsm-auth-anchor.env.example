# ── kgsm-auth-anchor — host overrides ─────────────────────────────────────────
# Seeded once by deploy/setup.sh and never written again, so anything set here survives every
# redeploy. Every key the daemon reads is declared in kgsm-auth-anchor.settings.json beside the
# binary; a variable naming a key that is not declared there binds to nothing and sets nothing.
#
# The unit's own Environment= lines carry working defaults, so this file is entirely optional —
# deleting it is a supported way to say "no overrides".
#
# The cluster secret is NOT here. It is host-level, in /etc/kgsm/kgsm-cluster.env, because a
# machine can run more than one member and they all carry the same one.

# The browser origins allowed to sign in against this anchor, comma-separated. The Control Panel is
# served from a different origin, so without an entry for it the browser discards this anchor's
# answer before the sign-in code sees it. There is deliberately no wildcard.
#Anchor__AllowedOrigins=https://panel.example,http://127.0.0.1:5173

# Where this anchor listens. Loopback by default, because a reverse proxy publishes it and holds
# the certificate. Change the port here rather than in the unit.
#Anchor__ListenAddress=http://127.0.0.1:8098

# The address other members and browsers reach this anchor at, and the origin of its provider
# callbacks. Leave it unset in a cluster with a DNS anchor: the accounts capability's name is used
# while this anchor serves it. Set it only where no DNS anchor names this one — it is what the roster
# carries, so getting it wrong means members pointing at an address that answers nobody.
#Anchor__PublicBaseUrl=https://auth.example

# Where this machine is reached from the internet — normally the dynamic-DNS name its network keeps
# pointed at a changing home address. In a cluster with a DNS anchor, the accounts capability's name
# (auth.anchors.<zone>) points at it while this anchor holds the capability, and this anchor serves it
# on a certificate the DNS anchor issues.
#Anchor__PublicHost=example.ddns.net

# The cluster this anchor holds the accounts for. It is the audience of every session it mints, so
# changing it on a running cluster signs everybody out.
#Anchor__ClusterId=kgsm-cluster

# How long a bearer lasts, and how long somebody stays signed in.
#Anchor__AccessLifetimeMinutes=15
#Anchor__RefreshLifetimeDays=30

# Minimum severity this anchor logs.
#Logging__LogLevel__Default=Information
