<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>TheKrystalShip.KGSM.Auth.Access</RootNamespace>
    <AssemblyName>TheKrystalShip.KGSM.Auth.Access</AssemblyName>

    <!--
      Zero package dependencies and AOT-safe, for the same reason as TheKrystalShip.KGSM.Auth: every
      member evaluates access with this, and so do the Native AOT leaves (the reactor, the scheduler)
      that check their own service accounts before acting. Reading the replica off disk is the
      account store's job, in Auth.Users; this package is the rules over what was read.
    -->
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>

    <PackageId>TheKrystalShip.KGSM.Auth.Access</PackageId>
    <Authors>Heisenberg</Authors>
    <Version>1.0.0-dev.2</Version>
    <Description>
      The KGSM access model and its evaluator: actions declared by components, permissions bundling
      them, ranked roles, assignments scoped to a cluster, a node or an instance, service accounts and
      the automations people author for them. Allows(account, action, target) answers every access
      question on every member from that member's replica, and the administration rules decide which
      changes to it a caller may make. Dependency-free and AOT-safe.
    </Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TheKrystalShip.KGSM.Auth.Access.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
