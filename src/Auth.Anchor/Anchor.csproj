<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Native AOT, like every other anchor and leaf. Nothing this daemon uses blocks it: the host
         is the slim builder with minimal APIs rather than MVC, storage is raw ADO SQLite rather than
         an ORM, and every wire shape is serialized through a source-generated context. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsAotCompatible>true</IsAotCompatible>

    <RootNamespace>TheKrystalShip.KGSM.Auth.Anchor</RootNamespace>
    <AssemblyName>kgsm-auth-anchor</AssemblyName>
    <Version>1.29.1</Version>

    <!-- The config descriptor is generated from AnchorSettings by TheKrystalShip.KGSM.ComponentConfig.
         These name the two files it works between; the attribute source, the documentation file the
         <panel> tags travel in and the build step all come with the package. -->
    <ComponentSettingsFile>kgsm-auth-anchor.settings.json</ComponentSettingsFile>
    <ComponentDescriptorFile>$(MSBuildProjectDirectory)/../../deploy/kgsm-auth-anchor.anchor.json</ComponentDescriptorFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The settings file, named for this daemon rather than appsettings.json so it cannot collide
         with a sibling's config if they ever share a directory. The Web SDK only auto-copies the
         literal "appsettings.json", so the renamed file needs an explicit item to reach bin/ and
         publish/. Program.cs loads it from AppContext.BaseDirectory, where deploy installs it. -->
    <Content Update="kgsm-auth-anchor.settings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The account store and the session tokens. Referenced by project because they are this repo's
         own; every consumer outside it pins a published version instead. -->
    <ProjectReference Include="../Auth.Users/Auth.Users.csproj" />
    <ProjectReference Include="../Auth.Sessions/Auth.Sessions.csproj" />
    <ProjectReference Include="../Auth.Discord/Auth.Discord.csproj" />

    <!-- The shape of an account event. Shared rather than spelled out here because a host that holds
         its own accounts writes the same lines from its own API, and a field spelled differently by
         one of the two writers deserializes to null at the reader instead of failing. -->
    <ProjectReference Include="../Auth.Journal/Auth.Journal.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The write half of a producer's event journal: the envelope, the append, and the layout rule a
         reader inverts to attribute a line. Its whole dependency surface is a logger and a service
         collection, which is what lets a Native AOT daemon record what it did without the
         engine-interop library arriving behind it. -->
    <PackageReference Include="TheKrystalShip.KGSM.Journal" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Cluster membership and durable member-to-member messaging. The anchor is a member like any
         other: it joins directly, answers the same wire, and needs no kgsm-api to do it. -->
    <PackageReference Include="TheKrystalShip.KGSM.Cluster" Version="1.0.0-dev.22" />
    <!-- The member half of the cluster's names: stating where this anchor is reached, and keeping a
         certificate and a served site for the capability name it holds. -->
    <PackageReference Include="TheKrystalShip.KGSM.Dns" Version="0.2.0-dev.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build-only: the descriptor attributes arrive as source and the generator as a tool, and the
         package declares no dependencies of its own, so none of it reaches the AOT publish. -->
    <PackageReference Include="TheKrystalShip.KGSM.ComponentConfig" Version="3.0.0" PrivateAssets="all" />

    <!-- The other half of the same repo: reading back the descriptor the line above generated, and
         serving what it describes. This anchor owns its own configuration and its own journal because
         it is a peer of every node rather than something one of them hosts — and every component owns
         those for the same reason, which is why the implementation is a package and not code here. -->
    <PackageReference Include="TheKrystalShip.KGSM.ComponentSurface" Version="1.0.0-dev.5" />
    <PackageReference Include="TheKrystalShip.KGSM.ComponentSurface.Http" Version="1.0.0-dev.2" />

    <!-- The Control Panel's wire shapes, which the surface above answers in. Pinned directly because
         this daemon names them at its own endpoints. -->
    <PackageReference Include="TheKrystalShip.KGSM.Api.Contracts" Version="1.0.0-dev.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- Scoped, same advisory and same reasoning as Auth.Users' own: a native SQLite lib pulled in
         transitively, where the flagged version is the latest published build and there is nothing
         to move to. A suppression does not travel with a reference, so the consuming project
         declares its own. Delete it the moment a patched SQLitePCLRaw bundle ships. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TheKrystalShip.KGSM.Auth.Anchor.Tests" />
  </ItemGroup>

</Project>
