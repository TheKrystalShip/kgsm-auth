{
  // === KGSM auth anchor — configuration ===
  //
  // This file declares the daemon's WHOLE configurable surface, each key with its default. It is
  // the floor; an environment variable overrides one key of it by spelling that key's path with
  // "__" — Anchor__ListenAddress, Logging__LogLevel__Default. A variable naming a key that is not
  // declared here binds to nothing, which is what stops a stale override from looking applied.
  //
  // Every key below maps 1:1 onto a property of AnchorSettings, which the daemon binds in one step,
  // and onto a [ConfigField] the config descriptor is generated from. A knob that exists in one place
  // and not the others fails the build.

  "Anchor": {
    // Where the browser reaches this anchor. A person signs in here directly, once, for the whole
    // cluster, so unlike a leaf's unix socket this is a TCP surface with TLS terminated the way any
    // member's is.
    "ListenAddress": "http://0.0.0.0:8098",

    // The name other members know this anchor by. A machine can run more than one member — a node
    // and an anchor are two members with two names — so this is deliberately not the machine's name.
    // Blank derives one from it, which is why no default is published for this key: an empty string
    // is not what the anchor falls back to.
    "MemberId": "",

    // The address other members reach this anchor at. Blank leaves it to the addresses the join
    // exchange reflects back, which is the right answer on a machine that can see its own.
    "PublicBaseUrl": "",

    // Where this machine is reached from the internet — normally its network's dynamic-DNS name. The
    // cluster's DNS anchor points the accounts capability's name at it while this anchor holds it.
    // Blank states no host, and the name is not published.
    "PublicHost": "",

    // The cluster a session is scoped to. It is the token audience: a session minted here is valid
    // on every member of THIS cluster and on nothing else. Changing it invalidates every token
    // already issued, so a running cluster keeps the value it started with.
    "ClusterId": "kgsm-cluster",

    // The token issuer, and — when it is this anchor's browser-facing URL — the address the cluster's
    // OpenID Connect sign-in is served under. The provider's doors serve nothing until it is a URL.
    // Validated, so changing it on a running anchor signs everyone out.
    "Issuer": "kgsm",

    // The account store. The same file every other KGSM surface on a host reads, and the anchor is
    // the writer of it.
    "UserStorePath": "/var/lib/kgsm/auth/users.db",

    // Where live sessions are recorded, so a revoke outlives the process that issued it and a
    // restart does not sign everybody out. Inside the unit's StateDirectory=.
    "SessionStorePath": "/var/lib/kgsm-auth-anchor/sessions.db",

    // The private key sessions are signed with. Generated on first start if absent, 0600, and never
    // leaves this machine. Deleting it invalidates every session ever minted.
    "SigningKeyPath": "/var/lib/kgsm-auth-anchor/session-signing.pem",

    // The descriptor this anchor serves its own configuration page from — written by its build and
    // installed by its deploy, into the anchors directory rather than where a node's leaves are
    // scanned for. Absent, this daemon serves no configuration surface at all.
    "ConfigDescriptorPath": "/var/lib/kgsm/anchors/auth-anchor.json",

    // Where a change made on that page is written. A systemd drop-in feeds it back with
    // EnvironmentFile=-, ordered after everything else the unit loads, so it wins. Deleting the file
    // returns every knob to what this host's deploy set — which is how this anchor is recovered if a
    // change stops it starting.
    "ConfigOverridePath": "/var/lib/kgsm-auth-anchor/config-override.env",

    // The provider's pages — sign-in, registration, the wait for approval and the account page — as
    // the kgsm-web-auth package installs them, served at /ui/. Absent, people still sign in through
    // a plain form this daemon renders itself.
    "UiPath": "/usr/share/kgsm-web-auth",

    // How long an access bearer lives before it has to be refreshed. Short, because it bounds how
    // long a stolen one is worth anything.
    "AccessLifetimeMinutes": 15,

    // The absolute session cap: how long somebody stays signed in, rotating access tokens, before a
    // fresh sign-in.
    "RefreshLifetimeDays": 30,

    // Origins a Control Panel is served from with no member behind it, comma-separated. Each is a
    // client of this provider at the panel's own paths. A panel a node serves is announced instead.
    "PanelOrigins": "",

    // Whether a person with no account may create one from the sign-in page. It is an unauthenticated
    // write, so it is off unless a cluster decides otherwise — and the account it creates holds
    // nothing until an administrator grants it something. The provider door creates the same kind of
    // account for anybody who can complete a sign-in at a configured provider, and both are bounded
    // by the same limit below.
    "AllowSelfRegistration": false,

    // How many accounts that arrived on their own may await approval at once. Signing in with an
    // external account nobody has approved creates one, and that door is open to anyone who can
    // complete a login at a configured provider — so this bounds what a stranger can fill up.
    "PendingCap": 25,

    // How long an unapproved account that arrived on its own survives before it is removed. It only
    // ever removes an account nobody has granted anything to.
    "PendingTtlDays": 14,

    // How long after proving a credential somebody may keep changing how they sign in on the account
    // page. Being signed in on a browser is not the same as having proved you own the account, and
    // attaching an identity outlives the session: afterwards whoever holds that provider account can
    // sign in as this one.
    "ReauthWindowMinutes": 5,

    // How often every member is told which version of roles and permissions is current.
    "AuthorityHeartbeatSeconds": 60,

    // How long a member keeps serving more than reads after it last heard that heartbeat. Held to at
    // least two heartbeats.
    "StalenessBoundSeconds": 300,

    // How often dead session rows are swept. The sweep only deletes what is already past its cap;
    // it is housekeeping, not revocation.
    "SessionCleanupMinutes": 60
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
