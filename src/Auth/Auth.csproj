<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>TheKrystalShip.KGSM.Auth</RootNamespace>
    <AssemblyName>TheKrystalShip.KGSM.Auth</AssemblyName>

    <!--
      Zero package dependencies, by design. Every KGSM surface takes this assembly — including the
      Discord bot, whose deploy is tuned for footprint, and the CLI, whose startup a consumer feels
      directly. Anything this referenced would reach all of them, so the tier model stays a pure
      library: no HTTP, no configuration binder, no ORM. The transports that DO need those live in
      the sibling packages, which only the surfaces that need them take.
    -->
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>

    <PackageId>TheKrystalShip.KGSM.Auth</PackageId>
    <Authors>Heisenberg</Authors>
    <Version>1.1.0</Version>
    <Description>
      The KGSM authorization model: the ordered viewer/operator/admin tier, the provider-agnostic
      KgsmIdentity and the IIdentityProvider/IAuthorityProvider seams that separate who someone is from
      what they may do, the OAuth state+PKCE handshake, the session claim and relay header names, and
      the provider:name actor convention. One definition of who may do what, shared by every surface
      onto a host, so the same person gets the same authority through the Control Panel, the assistant
      and the Discord bot alike. Dependency-free and AOT-safe.
    </Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
